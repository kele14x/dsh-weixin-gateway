# dsh-weixin-gateway — systemd *user* unit for the DSH Host that carries the
# WeChat channel.
#
# The gateway is not a standalone daemon: it is a Cordis plugin mounted inside
# the DSH Host. The process to supervise is therefore `dsh web`, which both
# provides `sessionController` and keeps the iLink long poll alive. Nothing is
# exposed to the network beyond the Host's own 127.0.0.1 browser UI; WeChat
# traffic is outbound HTTPS only.
#
# Install (never with sudo):
#   deploy/systemd/install.sh
# or by hand:
#   install -Dm644 deploy/systemd/dsh-weixin-gateway.service \
#     ~/.config/systemd/user/dsh-weixin-gateway.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now dsh-weixin-gateway.service
#
# Logs:
#   journalctl --user -u dsh-weixin-gateway -f
#
# One poller per bot token: stop this unit before running `dsh web` by hand, or
# the second poller trips iLink's `-14` "another poller" guard.

[Unit]
Description=DSH Web Host with the WeChat (iLink bot) channel
Documentation=file://%h/Workspaces/dsh-weixin-gateway/README.md
# Ordering only: a user manager has no network-online.target of its own, and
# the iLink client backoff covers a Host that starts before the network is up.
After=network-online.target
# A gateway must survive network outages and iLink's hour-long -14 pause, so it
# keeps retrying instead of latching into `failed`.
StartLimitIntervalSec=0

[Service]
Type=simple
# WeChat sessions default to the plugin's workspace/ directory (src/index.mjs),
# and the Host's workspace sandbox root should be the directory it starts in.
WorkingDirectory=%h/Workspaces/dsh-weixin-gateway/workspace
Environment=DSH_HOME=%h/.dsh
# `dsh` is a `#!/usr/bin/env node` script and Node comes from Linuxbrew, so the
# unit cannot rely on systemd's minimal PATH. This also gives agent bash tools
# the same executables an interactive shell sees.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
# Optional, mode 0600 — pairing code and any other overrides:
#   DSH_WEIXIN_BIND_CODE=choose-a-code
#   DSH_WEIXIN_CWD=/path/to/another/workspace
# Restart the unit after editing: pairing reads the variable from the process
# environment at message time.
EnvironmentFile=-%h/.config/dsh-weixin-gateway.env
# --no-open: at boot there is no desktop to receive a browser; the URL is
# printed to the journal instead. Add `--port 3080` to pin the UI port.
ExecStart=%h/.local/bin/dsh web --no-open
Restart=always
RestartSec=10
TimeoutStopSec=45
# The Host fans work out to sessions and their child processes, so the default
# soft limit of 1024 descriptors is low.
LimitNOFILE=65536
SyslogIdentifier=dsh-weixin
# Optional hardening, off because the Host shells out to agent tools: enabling
# it can break commands that expect a permissive environment.
# NoNewPrivileges=yes
# PrivateTmp=yes

[Install]
WantedBy=default.target
