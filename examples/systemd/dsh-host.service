# Optional DSH Host example; customize executable and runtime paths before use.
[Unit]
Description=DSH Web Host
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/dsh-workspace
Environment=DSH_HOME=%h/.dsh
Environment=DSH_WEIXIN_CWD=%h/dsh-workspace
# systemd does not inherit the interactive shell's Node or agent-tool PATH.
Environment=PATH=/absolute/path/to/node-bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/dsh-weixin-gateway.env
ExecStart=/absolute/path/to/dsh web --no-open
Restart=always
RestartSec=10
TimeoutStopSec=45
LimitNOFILE=65536

[Install]
WantedBy=default.target
